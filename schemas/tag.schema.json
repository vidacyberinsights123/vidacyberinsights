{
    "$id": "tag.schema.json",
    "type": "object",
    "required": [
        "id",
        "name",
        "slug"
    ],
    "properties": {
        "id": {
            "type": "string"
        },
        "name": {
            "type": "string"
        },
        "slug": {
            "type": "string",
            "pattern": "^[a-z0-9-]+$"
        },
        "description": {
            "type": "string"
        }
    }
}